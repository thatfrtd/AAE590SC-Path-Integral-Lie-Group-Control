function u_new = weightfunc(u_n, deltaU, S, lambda)

Smin = min(S);
w = exp(-(S - Smin)/lambda);
Wsum = sum(w) + 1e-12; % avoid divide by zero

% Weighted update
u_new = u_n;
for n = 1:N
    dsum = zeros(1, Nu);
    for k = 1:K
        dsum = dsum + w(k) * squeeze(deltaU(k,n,:)).';
    end
    u_new(:, n) = u_n(:, n) + (dsum / Wsum).';
end

end
