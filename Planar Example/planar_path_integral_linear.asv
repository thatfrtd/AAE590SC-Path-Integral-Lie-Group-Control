%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% AAE 590SC
% Path Integral Control on Lie Groups
% Author: Travis Hastreiter 
% Created On: 3 November, 2025
% Description: Test of stochastic propagation without optimized control
% Most Recent Change: 3 November, 2025
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Create Dynamics 
z2 = zeros(2);
I2 = eye(2);

A = [z2, I2; z2, z2];
B = [z2; I2];

f = @(t, x, u) A * x + B * u;
control_delta_t = 0.01;
t_k = 0:control_delta_t:1;
u_k =  * ones([2, numel(t_k)]);

%% Define Initial Condition and Target
x0 = [0; 1; 0; 2];
xtarg = [10; 0; 0; 0];

%% Define Noise
noise_delta_t = 1e-2;

w = @(n) randn([2, n]);

sigma_accel = 4; % [m / s2]
sigma = [sigma_accel, 0; 0, sigma_accel] * sqrt(noise_delta_t); % need to double check the sqrt(delta t) part

%% Run Monte Carlo
m = 50;

x = zeros([4, numel(tspan), m]);
t = zeros([numel(tspan), m]);
u_n = zeros([2, numel(tspan), m]);
delta_u = zeros([2, numel(tspan), m]);

tolerances = odeset(RelTol=1e-12, AbsTol=1e-12);

iterations = 10;
lambda = 100;

for j = 1 : iterations
    parfor i = 1 : m
        [t(:, i), x(:, :, i), u_n(:, :, i), delta_u(:, :, i)] = sode45(f, u_k, sigma, w, t_k, noise_delta_t, x0, tolerances);
    end
    
    L = cost(x, xtarg, u_n + delta_u, control_delta_t);
    u_k = weightfunc(u_n, delta_u, L, lambda);

    sum(L) / numel(L)
end


%% Time Histories
figure
tiledlayout(1, 3);

nexttile
plot(t, squeeze(x(1, :, :))); hold on
plot(t, squeeze(x(2, :, :)));
xlabel("Time")
ylabel("Position")
legend("r_x", "r_y")
title("Position vs Time")
grid on

nexttile
plot(t, squeeze(x(3, :, :))); hold on
plot(t, squeeze(x(4, :, :)));
xlabel("Time")
ylabel("Velocity")
legend("v_x", "v_y")
title("Velocity vs Time")
grid on

nexttile
plot(t, squeeze(u_n(1, :, :) + delta_u(1, :, :))); hold on
plot(t, squeeze(u_n(2, :, :) + delta_u(2, :, :)));
xlabel("Time")
ylabel("Control")
legend("a_x", "a_y")
title("Control Acceleration vs Time")
grid on

%% Trajectory
figure
plot(squeeze(x(1, :, :)), squeeze(x(2, :, :)))
xlabel("X [m]")
ylabel("Y [m]")
title("Trajectory")
grid on